{
  "name": "onestate-mod-menu",
  "version": "1.0.0",
  "private": true,
  "description": "OneState RP Companion App",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node app.js"
  },
  "dependencies": {
    "expo": "~49.0.23",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  }
}function abrirMenu() {
  const menu = document.createElement("div");

  menu.innerHTML = `
    <h2>🔥 ONESTATE MENU</h2>
    <button onclick="mostrarOuro()">🪙 OURO</button>
    <p id="ouro">Ouro de demonstração: 0</p>
  `;

  document.body.appendChild(menu);
}

function mostrarOuro() {
  document.getElementById("ouro").innerText =
    "Ouro de demonstração: 1000";
}

abrirMenu();
